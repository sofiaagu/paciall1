  lineas:
  - globoDialogo: {fileID: 206024261}
    textoTMP: {fileID: 1329307437}
    textoCompleto: "Hola chicos! \nQue buen dia para jugar!"
  - globoDialogo: {fileID: 1485010830}
    textoTMP: {fileID: 174263528}
    textoCompleto: Hola Milo! Si, el clima esta perfecto.
  - globoDialogo: {fileID: 1571667012}
    textoTMP: {fileID: 546318197}
    textoCompleto: Sssssi... pero oigan, no falta alguien aqu?
  - globoDialogo: {fileID: 628299610}
    textoTMP: {fileID: 97091879}
    textoCompleto: Es verdad... donde esta Riko? El nunca llega tarde.
  velocidadEscritura: 0.04
  audioSourceTuc: {fileID: 1606218370}
  sonidoTuc: {fileID: 0}
