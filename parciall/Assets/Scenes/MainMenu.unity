  m_EditorClassIdentifier: Assembly-CSharp::HistoriaManager
  lineas:
  - globoDialogo: {fileID: 830196252}
    textoTMP: {fileID: 414850431}
    textoCompleto: Riko! Al fin te encontramos, donde estabas? Nos tenias preocupados.
  - globoDialogo: {fileID: 1112930987}
    textoTMP: {fileID: 1751111362}
    textoCompleto: Hola chicos, solo estaba caminando por el bosque disfrutando el
      dia.
  - globoDialogo: {fileID: 2127225945}
    textoTMP: {fileID: 1168368342}
    textoCompleto: Mmm... esperen... me huele a algo delicioso por alla...
  velocidadEscritura: 0.04
  audioSourceTuc: {fileID: 1606218370}
  sonidoTuc: {fileID: 0}
  botonSiguiente: {fileID: 884229887}
