  lineas:
  - globoDialogo: {fileID: 551795684}
    textoTMP: {fileID: 2057007062}
    textoCompleto: Oigan... nossss volvimos a dessscuidar , Riko se volvio a escapar
      hacia el bosque!
  - globoDialogo: {fileID: 2089308738}
    textoTMP: {fileID: 194632440}
    textoCompleto: Ay no, otra vez! Tenemos que alcanzarlo antes de que se meta en
      problemas!
  - globoDialogo: {fileID: 187314443}
    textoTMP: {fileID: 1676459826}
    textoCompleto: Estoy seguro que por aqui olia a queso...
  velocidadEscritura: 0.04
